<UserControl x:Class="Modern.Lab.Controls.Wpf.Display.ModernMessageDetailsControl"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Modern.Lab.Controls.Wpf.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             x:Name="RootControl"
             FontFamily="{DynamicResource Font.Family}"
             d:DesignWidth="540" d:DesignHeight="168">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/Tokens.xaml" />
                <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/ControlParts.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        메시지 다이얼로그의 기술 상세 박스. 본문 박스(ModernMessageDialogControl)와
        같은 생김새다 — 옅은 배경 + 연한 1px 테두리 + 둥근 모서리 + 박스 안 오른쪽 위
        복사 아이콘. 왼쪽 여백 76은 본문의 Padding(20) + 아이콘 열(40 + 16)이라
        두 박스의 세로 선이 맞는다. 복사는 제목·본문·상세를 함께 담는다(호스트 폼 처리).
    -->
    <Border Background="{StaticResource Brush.Surface}" Padding="76,8,20,12">
        <Border Background="{StaticResource Brush.SurfaceAlt}"
                BorderBrush="{StaticResource Brush.BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Md}"
                Padding="12,10">
            <Grid>
                <TextBox x:Name="DetailsText"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="False"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0,0,40,0"
                         FontSize="{StaticResource Font.Size.BodyLg}"
                         Foreground="{StaticResource Brush.TextPrimary}"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled" />

                <Button x:Name="CopyButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,0,16,0"
                        Style="{StaticResource Parts.CopyIconButtonStyle}"
                        ToolTip="Copy message and details"
                        Click="OnCopyButtonClick">
                    <TextBlock x:Name="CopyGlyph"
                               FontFamily="{StaticResource Font.Family.Icon}"
                               FontSize="{StaticResource Font.Size.IconSm}"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               Text="&#xE8C8;" />
                </Button>
            </Grid>
        </Border>
    </Border>
</UserControl>
