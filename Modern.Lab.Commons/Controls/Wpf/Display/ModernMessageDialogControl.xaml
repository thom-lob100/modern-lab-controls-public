<UserControl x:Class="Modern.Lab.Controls.Wpf.Display.ModernMessageDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Modern.Lab.Controls.Wpf.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             x:Name="RootControl"
             FontFamily="{DynamicResource Font.Family}"
             d:DesignWidth="420" d:DesignHeight="160">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/Tokens.xaml" />
                <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/ControlParts.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        메시지 다이얼로그 본문: [종류 색 아이콘 원] [제목 + 본문].
        버튼은 이 컨트롤에 없다 — 호스트 폼(ModernMessageDialog)이 ModernButton으로
        놓아 AcceptButton/CancelButton(Enter/Esc)을 폼 관례대로 쓴다.

        본문은 읽기 전용 TextBox다 — 긴 서버 오류 문구를 **드래그해 복사**할 수
        있어야 하기 때문이다(TextBlock은 선택이 안 된다). 테두리·배경을 없애
        보기에는 글자만 남는다.
    -->
    <Border Background="{StaticResource Brush.Surface}" Padding="20,18,20,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 종류 아이콘 — 옅은 배경 원 + 진한 글리프(토스트와 같은 문법) -->
            <Border x:Name="IconCircle"
                    Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                    Width="40" Height="40"
                    CornerRadius="20"
                    VerticalAlignment="Top"
                    Margin="0,0,16,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Brush.InfoBackground}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Success">
                                <Setter Property="Background" Value="{StaticResource Brush.SuccessBackground}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Warning">
                                <Setter Property="Background" Value="{StaticResource Brush.WarningBackground}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Error">
                                <Setter Property="Background" Value="{StaticResource Brush.ErrorBackground}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock FontFamily="{StaticResource Font.Family.Icon}"
                           FontSize="{StaticResource Font.Size.Icon}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- 기본 = Information: i 아이콘 -->
                            <Setter Property="Text" Value="&#xE946;" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.InfoText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Success">
                                    <Setter Property="Text" Value="&#xE73E;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.SuccessText}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Warning">
                                    <Setter Property="Text" Value="&#xE7BA;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.WarningText}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Error">
                                    <Setter Property="Text" Value="&#xE711;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.ErrorText}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Question">
                                    <!-- E897(Help) — 배경 원과 겹치지 않는 순수 물음표 -->
                                    <Setter Property="Text" Value="&#xE897;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.InfoText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!--
                제목 — 비어 있으면 줄 자체를 접는다(본문만 있는 짧은 알림).
                색은 종류를 따라간다: 오류/경고/성공은 그 색의 텍스트 토큰,
                정보/확인은 기본 글자색. **제목만** 물들이고 본문은 기본색으로
                남긴다 — 긴 사유 전체가 빨간 글씨면 읽기 어렵고 과하다.
            -->
            <TextBlock x:Name="TitleText"
                       Grid.Row="0" Grid.Column="1"
                       Text="{Binding Title, ElementName=RootControl}"
                       FontSize="{StaticResource Font.Size.Title}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"
                       LayoutTransform="{Binding Path=(common:FontWidthScaling.TextWidthTransform), RelativeSource={RelativeSource Self}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Error">
                                <Setter Property="Foreground" Value="{StaticResource Brush.ErrorText}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Warning">
                                <Setter Property="Foreground" Value="{StaticResource Brush.WarningText}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Success">
                                <Setter Property="Foreground" Value="{StaticResource Brush.SuccessText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 본문 — 자동 줄바꿈 + 길면 스크롤. 선택/복사 가능.
                 글자는 BodyLg(14) — WPF 글리프는 같은 크기의 GDI보다 옅게 그려져 12px 본문이 흐려 보였다
                 (2026-09-03 실측: 진한 획 픽셀 GDI 305 · WPF 12px 90 · WPF 14px 200~220). 14px에서 GDI+ 라벨과
                 같은 무게가 된다. 제목(16)은 그대로.
                 RichTextBox인 이유: **단어** 표기로 감싼 구간을 액센트 SemiBold로 강조한다
                 ("OffLine → **OnLineLocal**로 변경하시겠습니까?"). 문서는 코드비하인드가
                 Message에서 만든다(BuildDocument). -->
            <Border Grid.Row="1" Grid.Column="1"
                    Background="{StaticResource Brush.SurfaceAlt}"
                    BorderBrush="{StaticResource Brush.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Md}"
                    Padding="12,10">
                <Grid>
                    <RichTextBox x:Name="MessageBox"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"
                                 IsDocumentEnabled="False"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 FontSize="{StaticResource Font.Size.BodyLg}"
                                 Foreground="{StaticResource Brush.TextPrimary}"
                                 VerticalAlignment="Stretch"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled" />

                    <Button x:Name="CopyButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,0,16,0"
                            Style="{StaticResource Parts.CopyIconButtonStyle}"
                            ToolTip="Copy message"
                            Click="OnCopyButtonClick">
                        <TextBlock x:Name="CopyGlyph"
                                   FontFamily="{StaticResource Font.Family.Icon}"
                                   FontSize="{StaticResource Font.Size.IconSm}"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Text="&#xE8C8;" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
