<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:Modern.Lab.Controls.Wpf.Common">

    <!-- 컨트롤 공용 파츠 사전: 여러 컨트롤 XAML에 복제되어 있던 템플릿/스타일을
         한곳에 모은다. 각 컨트롤은 Tokens.xaml 병합 뒤에 이 사전을
         SharedResourceDictionary로 병합해 사용한다.

         주의:
         - 아래 일부 스타일의 트리거는 ElementName=RootControl 바인딩을 쓴다.
           스타일이 적용되는 요소의 네임스코프에서 이름을 찾으므로, 소비하는
           컨트롤의 루트 UserControl x:Name이 반드시 "RootControl"이어야 한다.
         - 토큰 StaticResource가 이 사전 단독으로도 해석되도록 Tokens.xaml을
           먼저 병합한다 (SharedResourceDictionary는 URI 캐시라 중복 비용 없음). -->
    <ResourceDictionary.MergedDictionaries>
        <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 모던 툴팁 — 기본 WPF(누런 시스템 룩) 대신 Surface 배경 + 은은한 테두리
         + 둥근 모서리 + 소프트 그림자. 색은 전부 DynamicResource 테마 토큰이라
         테마(Blue/Dark/CrimsonGray 등)에 맞춰 자동으로 바뀐다. 암시적 스타일이라
         이 리소스를 병합하는 컨트롤(그리드 등) 안의 툴팁 전부에 적용된다. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1.5"
                                              Direction="270" Opacity="0.18" Color="#FF000000" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 드롭다운 필드 표면 + 셰브런 (ModernComboBox / ModernCheckComboBox 공용).
         IsChecked가 드롭다운 열림을 제어한다. -->
    <ControlTemplate x:Key="Parts.FieldToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="FieldBorder"
                CornerRadius="{StaticResource Radius.Sm}"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1">
            <TextBlock Text="&#xE70D;"
                       FontFamily="{StaticResource Font.Family.Icon}"
                       FontSize="{StaticResource Font.Size.IconSm}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Foreground="{StaticResource Brush.TextSecondary}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Brush.FocusBorder}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="FieldBorder" Property="Background" Value="{StaticResource Brush.DisabledBackground}" />
                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 복사 아이콘 버튼 (메시지 다이얼로그 본문·상세 박스 공용): 28px 투명 칩,
         hover에만 옅은 배경. 포커스를 가져가지 않아 Enter/Esc가 폼 버튼에 남는다. -->
    <Style x:Key="Parts.CopyIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="{StaticResource Radius.Sm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{StaticResource Brush.HoverBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 모던 체크박스(박스 18px + 콘텐츠): 둥근 사각(4px) + 액센트 채움 + 흰 체크 글리프.
         IsChecked=null(부분 선택)은 대시 글리프로 표시 -->
    <Style x:Key="Parts.CheckBoxStyle" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="18" Height="18"
                                CornerRadius="4"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="Glyph"
                                       Text="&#xE73E;"
                                       FontFamily="{StaticResource Font.Family.Icon}"
                                       FontSize="{StaticResource Font.Size.Icon}"
                                       Foreground="{StaticResource Brush.OnAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          LayoutTransform="{Binding Path=(common:FontWidthScaling.TextWidthTransform), RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- 부분 선택(전체 선택 헤더 전용) -->
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE738;" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.DisabledBackground}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 그리드 셀/헤더 체크박스(박스 16px 전용): Parts.CheckBoxStyle과 같은 모던
         비주얼의 박스 전용 버전 — OS 기본 체크박스 룩을 쓰지 않는다.
         헤더 전체선택의 중간 상태(일부만 체크)는 액센트 채움 + 대시 글리프로 표시한다. -->
    <Style x:Key="Parts.GridCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box"
                            Width="16" Height="16"
                            CornerRadius="4"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="Glyph"
                                   Text="&#xE73E;"
                                   FontFamily="{StaticResource Font.Family.Icon}"
                                   FontSize="{StaticResource Font.Size.IconSm}"
                                   Foreground="{StaticResource Brush.OnAccent}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE738;" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.DisabledBackground}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
                        </Trigger>
                        <!-- 잠긴 채 체크된 셀(CheckEnabledMember 거짓 + 값 참): 흰 글리프가 비활성 배경에
                             묻혀 "체크 안 됨"으로 보이던 것(2026-08-29). 회색 채움 + 흰 체크로
                             "선택돼 있으나 바꿀 수 없음"을 보인다. IsEnabled 트리거 뒤에 둬 우선한다. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.DisabledText}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.DisabledText}" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 그리드 셀 스위치(GridCheckStyle.Switch 전용): ModernCheckBox의 Switch와
         같은 문법(알약형 트랙 + 원형 썸)을 셀 높이에 맞춰 줄인 것.
         "선택"이 아니라 설정을 켜고 끄는 컬럼에 쓴다 — 끌 수 없는 행
         (CheckEnabledMember 거짓)은 비활성 트랙으로 잠긴 것이 보인다. -->
    <Style x:Key="Parts.GridSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track"
                            Width="32" Height="16"
                            CornerRadius="8"
                            Background="{StaticResource Brush.Border}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <Ellipse x:Name="Thumb"
                                 Width="10" Height="10"
                                 Fill="{StaticResource Brush.OnAccent}"
                                 HorizontalAlignment="Left"
                                 Margin="3,0,3,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.BorderHover}" />
                        </Trigger>
                        <!-- 켬 상태가 hover보다 우선하도록 뒤에 선언 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <!-- 잠긴 스위치: 다크 테마에서 비활성 배경이 행 배경과 거의
                             같아 트랙이 사라져 보인다 — 외곽선으로 형태를 남긴다. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.DisabledBackground}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource Brush.BorderSubtle}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 그리드 셀 콤보 항목 (GridColumnKind.Combo 전용) — ModernComboBox
         항목과 같은 문법의 컴팩트 버전. -->
    <Style x:Key="Parts.GridComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,4,10,4" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Label}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- 선택 항목 표시(체크 ✓)는 컨테이너가 아니라 **항목 템플릿
                     내용 안**에서 그린다 — 배지형은 칩 안에, 텍스트형은 글자
                     앞에 (GridColumnFactory가 만드는 항목 템플릿 참고). 여기는
                     hover 채움만 담당한다 (2026-07-31 확정). -->
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="Transparent"
                            CornerRadius="{StaticResource Radius.Sm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.HoverBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 그리드 셀 콤보의 필드 표면 + 셰브런 — Parts.FieldToggleTemplate과
         같은 문법이지만 배경을 TemplateBinding으로 받아, 배지형 콤보가 선택
         값의 배지 색으로 필드 전체를 칠할 수 있다 (기본은 스타일의 Surface). -->
    <ControlTemplate x:Key="Parts.GridComboToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="FieldBorder"
                CornerRadius="{StaticResource Radius.Sm}"
                Background="{TemplateBinding Background}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1">
            <TextBlock Text="&#xE70D;"
                       FontFamily="{StaticResource Font.Family.Icon}"
                       FontSize="{StaticResource Font.Size.IconSm}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Foreground="{StaticResource Brush.TextSecondary}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Brush.FocusBorder}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="FieldBorder" Property="Background" Value="{StaticResource Brush.DisabledBackground}" />
                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 그리드 셀 콤보 (GridColumnKind.Combo 전용): 24px 컴팩트 필드 —
         행 높이(32) 안에 세로 중앙으로 앉는다. 필드 배경은 ComboBox의
         Background를 따른다(기본 Surface) — 배지형 콤보는 이 값을 선택 값의
         배지 색으로 바인딩해 필드 전체가 배지처럼 칠해진다. -->
    <Style x:Key="Parts.GridComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="24" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Label}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Parts.GridComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropToggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      Template="{StaticResource Parts.GridComboToggleTemplate}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="ContentSite"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="10,0,26,0"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Sm}"
                                    Margin="0,2,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{StaticResource Brush.DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 둥근 필드 표면(OuterBorder) 공용 스타일: 테두리 색은 hover/포커스에
         반응하고, 배경은 비활성 상태에 반응한다. hover/포커스/비활성 판정이
         모두 루트(RootControl) 기준인 컨트롤(Numeric/Date/Month)에서 쓴다 —
         ModernTextBox는 hover 소스가 내부 에디터라 자체 스타일을 유지한다. -->
    <Style x:Key="Parts.FieldBorderStyle" TargetType="Border">
        <!-- 고정 Height가 아니라 MaxHeight: 호스트가 32 DIP보다 작은 슬롯을 주면
             (스케일되지 않은 폼의 고DPI) 필드가 줄어들어 잘림을 막는다. -->
        <Setter Property="MaxHeight" Value="{StaticResource Size.ControlHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=RootControl}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
            </DataTrigger>
            <!-- 포커스가 hover보다 우선: 나중에 선언되어 우선순위를 가진다 -->
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=RootControl}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.FocusBorder}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled, ElementName=RootControl}" Value="False">
                <Setter Property="Background" Value="{StaticResource Brush.DisabledBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 필수 미입력 점(RequiredDot) 공용 외형: 6×6 빨간 원, 기본 숨김.
         표시 트리거(Required + placeholder 표시)는 참조하는 형제 요소 이름이
         컨트롤마다 달라 각 컨트롤에서 BasedOn으로 덧붙인다. -->
    <Style x:Key="Parts.RequiredDotStyle" TargetType="Border">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Brush.ErrorBorder}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- placeholder 안내 텍스트 공용 외형: 회색 본문 크기, 히트 테스트 제외.
         표시/숨김 로직(코드 관리 또는 Text 빈 값 트리거)은 각 컨트롤이 가진다. -->
    <Style x:Key="Parts.PlaceholderTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPlaceholder}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="LayoutTransform" Value="{Binding Path=(common:FontWidthScaling.TextWidthTransform), RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- 카드 표면: 토큰 규칙(컨트롤 4 / 카드 8)에 따른 큰 반경.
         Flat=True이면 공용 카드 패널 위에서 쓰도록 크롬을 제거한다.
         기본 Padding은 16,10 — 다른 값이 필요한 컨트롤은 BasedOn으로 덮는다. -->
    <Style x:Key="Parts.CardSurfaceStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,10" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Flat, ElementName=RootControl}" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
